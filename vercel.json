{
  "redirects": [
    {
      "source": "/:path.html",
      "destination": "/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(cars|login_page|manage|settings|sold|index)",
      "destination": "/$1.html"
    }
  ],
  "cleanUrls": true, 
  "trailingSlash": false 
}